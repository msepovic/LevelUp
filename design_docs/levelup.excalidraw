      "boundElements": null,
      "updated": 1785086478715,
      "link": null,
      "locked": false,
      "text": "LevelUp - a fun and intutive web and mobile application that users use to \"level up\" their skills.\nThe premise of the app is simple - a habit tracker that users use to track their progress in certain categories (both\ndetermined, and self determined ones) and as they are more active the application will give for each category xp\npoints and level up their character in the application.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LevelUp - a fun and intutive web and mobile application that users use to \"level up\" their skills.\nThe premise of the app is simple - a habit tracker that users use to track their progress in certain categories (both determined, and self determined ones) and as they are more active the application will give for each category xp points and level up their character in the application.",
      "autoResize": false,
      "lineHeight": 1.25
    },
